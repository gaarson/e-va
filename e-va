#!/bin/bash
# --- Version Flag ---
if [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
    echo "E-va Agent v1.0.0"
    exit 0
fi
# --- AGENT_HOME Resolution & Validation ---
SOURCE="${BASH_SOURCE}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
AGENT_HOME="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
if [ ! -d "$AGENT_HOME" ]; then
    echo "[FATAL] AGENT_HOME ($AGENT_HOME) does not exist." >&2
    exit 1
fi
if [ ! -f "$AGENT_HOME/agent.lua" ]; then
    echo "[FATAL] Core file agent.lua not found in $AGENT_HOME." >&2
    exit 1
fi
if [ ! -f "$AGENT_HOME/config.lua" ]; then
    echo "[FATAL] Core file config.lua not found in $AGENT_HOME." >&2
    exit 1
fi
if [ -n "$GIT_EVA_URL" ]; then echo "Cloning $GIT_EVA_URL ..."; rm -rf /app/*; rm -rf /app/.* 2>/dev/null; git clone "$GIT_EVA_URL" /tmp/repo; cp -a /tmp/repo/. /app/; rm -rf /tmp/repo; fi

# --- PIPE MODE DOCUMENTATION ---
# The --pipe flag enables continuous stdin/stdout mode for external communication.
# Usage examples:
#   echo "analyze this code" | docker run -i e-va-agent ./e-va --pipe
#   docker run -it e-va-agent ./e-va --pipe  (for interactive session)
# Termination: Send 'quit' or 'exit' via stdin.
# --------------------------------------------------

PROJECT_ROOT="$(pwd)"

export AGENT_HOME
export PROJECT_ROOT

if [ -f "$PROJECT_ROOT/.env" ]; then
    export ENV_PATH="$PROJECT_ROOT/.env"
elif [ -f "$AGENT_HOME/.env" ]; then
    export ENV_PATH="$AGENT_HOME/.env"
fi

LUA_VERSION=$(lua -v 2>&1 | awk '{print $2}' | cut -d. -f1,2)

export LUA_PATH="$PROJECT_ROOT/.e-va-conf/?.lua;$AGENT_HOME/?.lua;$AGENT_HOME/?/init.lua;$AGENT_HOME/lua_modules/share/lua/${LUA_VERSION}/?.lua;$AGENT_HOME/lua_modules/share/lua/${LUA_VERSION}/?/init.lua;;"
export LUA_CPATH="$AGENT_HOME/?.so;$AGENT_HOME/lua_modules/lib/lua/${LUA_VERSION}/?.so;;"
# --- TTY Detection & Auto-Mode Hint ---
if [ -t 0 ] && [ $# -eq 0 ]; then
    echo "No arguments provided. Starting interactive TUI mode..."
    echo "Tip: Use --pipe for programmatic access, or provide a task instruction."
fi
exec lua "$AGENT_HOME/agent.lua" "$@"