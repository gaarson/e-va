FROM e-va-base:latest
LABEL org.opencontainers.image.title="E-va Browser Agent"

# Зависимости Chrome (библиотеки для рендеринга, шрифты, NSS, ALSA)
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs npm fonts-liberation libnss3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libgbm1 libasound2t64 libpangocairo-1.0-0 libgtk-3-0 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Установка Chrome (прямое скачивание .deb пакета)
RUN wget -q -O /tmp/google-chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb && \
    apt-get update && \
    apt-get install -y --no-install-recommends /tmp/google-chrome.deb && \
    rm -f /tmp/google-chrome.deb && \
    rm -rf /var/lib/apt/lists/*

# Обертка для Chrome (принудительный no-sandbox для Docker)
RUN mv /usr/bin/google-chrome-stable /usr/bin/google-chrome-stable-orig && \
    echo '#!/bin/bash' > /usr/bin/google-chrome-stable && \
    echo 'exec /usr/bin/google-chrome-stable-orig --no-sandbox --disable-setuid-sandbox --disable-dev-shm-usage "$@"' >> /usr/bin/google-chrome-stable && \
    chmod +x /usr/bin/google-chrome-stable

# MCP Сервер для управления браузером
RUN npm install -g chrome-devtools-mcp@latest

# Включаем браузерный модуль для init.sh
ENV EVA_MODULE_BROWSER=1
ENV CHROME_PATH=/usr/bin/google-chrome-stable
